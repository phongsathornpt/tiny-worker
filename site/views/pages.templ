package views

templ Layout(title string, content templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			<meta name="description" content="An open-source Go framework for Cloudflare Workers, compiled to WebAssembly with TinyGo."/>
			<title>{ title } · tiny-worker</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/tokens.css"/>
			<link rel="stylesheet" href="/site.css"/>
			<script type="module" src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.esm.min.js" integrity="sha384-lIFlfAj002Phzxvrea858KMM3/dXelBFF5rq+Oh5lChznUWuVI0mabAEUnsRa/2W" crossorigin="anonymous"></script>
			<script src="/site.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="wordmark" href="/" aria-label="tiny-worker home">tiny-worker<span class="wordmark__dot">.</span></a>
				<nav class="topnav" aria-label="Main navigation">
					<a href="/docs/">Docs</a>
					<a href="/quickstart/">Quickstart</a>
					<a href="/contributing/">Contributing</a>
				</nav>
				<button class="search-trigger" type="button" data-palette-open>
					<span>Search</span><kbd>⌘K</kbd>
				</button>
			</header>
			@content
			<footer class="site-footer">
				<div class="footer-intro">
					<a class="wordmark" href="/">tiny-worker<span class="wordmark__dot">.</span></a>
					<p>Small Go. Cloudflare Workers. Open source.</p>
				</div>
				<div class="footer-column">
					<h2>Learn</h2>
					<a href="/docs/">Documentation</a>
					<a href="/quickstart/">Quickstart</a>
					<a href="https://github.com/phongsathornpt/tiny-worker#rest-apis-rest-package">REST package</a>
				</div>
				<div class="footer-column">
					<h2>Project</h2>
					<a href="https://github.com/phongsathornpt/tiny-worker">Source code</a>
					<a href="https://github.com/phongsathornpt/tiny-worker/issues">Issues</a>
					<a href="/contributing/">Contributing</a>
				</div>
				<div class="footer-column">
					<h2>Details</h2>
					<a href="https://github.com/phongsathornpt/tiny-worker/blob/main/LICENSE">License</a>
					<a href="https://github.com/phongsathornpt/tiny-worker/releases">Releases</a>
				</div>
				<p class="footer-note">Built in the open. Read the code, file an issue, send a patch.</p>
			</footer>
			<dialog class="palette" aria-label="Site navigation" data-palette>
				<div class="palette__head">
					<label for="palette-search">Find a page</label>
					<button type="button" class="palette__close" data-palette-close>Esc</button>
				</div>
				<input id="palette-search" type="search" placeholder="Type to filter links" autocomplete="off" data-palette-input/>
				<nav class="palette__links" aria-label="Search results" data-palette-links>
					<a href="/">Home <span>Project overview</span></a>
					<a href="/docs/">Documentation <span>Framework guide</span></a>
					<a href="/quickstart/">Quickstart <span>Build your first worker</span></a>
					<a href="/contributing/">Contributing <span>Help improve tiny-worker</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker">GitHub <span>Source and issues</span></a>
				</nav>
			</dialog>
		</body>
	</html>
}

templ Home() {
	@Layout("Open-source Go for Cloudflare Workers", HomeContent())
}

templ HomeContent() {
	<main class="page-shell">
		<div class="page-meta"><span>Open source</span><span>Go 1.27</span><span>TinyGo 0.42+</span></div>
		<section class="intro" aria-labelledby="page-title">
			<h1 id="page-title">A small Go framework for Cloudflare Workers.</h1>
			<p>Build request handlers in Go, compile them to WebAssembly with TinyGo, and run them at the edge. The framework, examples, and build pipeline are open for inspection.</p>
			<div class="intro-links">
				<a class="text-link" href="/quickstart/">Start with the quickstart <span aria-hidden="true">→</span></a>
				<a class="text-link" href="https://github.com/phongsathornpt/tiny-worker">Browse the source <span aria-hidden="true">↗</span></a>
			</div>
		</section>
		<section class="install-strip" aria-labelledby="install-title">
			<div class="section-label">First run</div>
			<div class="install-body">
				<h2 id="install-title">Start from a working worker.</h2>
				<p>Install the CLI, scaffold an API, then run it locally with Wrangler.</p>
				<div class="code-switch" role="group" aria-label="Choose an example">
					<button type="button" class="code-switch__button is-active" hx-get="/fragments/example/hello" hx-target="#quickstart-code" hx-swap="innerHTML">Hello worker</button>
					<button type="button" class="code-switch__button" hx-get="/fragments/example/rest" hx-target="#quickstart-code" hx-swap="innerHTML">REST API</button>
				</div>
				<div class="code-panel" id="quickstart-code" aria-live="polite">
					@HelloExampleFragment()
				</div>
			</div>
		</section>
		<section class="index-section" aria-labelledby="index-title">
			<div class="section-label">Explore</div>
			<div class="index-body">
				<h2 id="index-title">A framework you can read end to end.</h2>
				<p>Start with the guide, inspect the examples, or follow a request through routing, middleware, and the Cloudflare bridge.</p>
				<div class="index-list">
					<a href="/docs/"><span class="index-number">01</span><span><strong>Documentation</strong><small>Install, route, build, and deploy.</small></span><span class="index-arrow">↗</span></a>
					<a href="/quickstart/"><span class="index-number">02</span><span><strong>Quickstart</strong><small>Get a worker running locally.</small></span><span class="index-arrow">↗</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker/tree/main/examples"><span class="index-number">03</span><span><strong>Examples</strong><small>Hello worker and typed REST API.</small></span><span class="index-arrow">↗</span></a>
					<a href="/contributing/"><span class="index-number">04</span><span><strong>Contributing</strong><small>Issues, patches, and project decisions.</small></span><span class="index-arrow">↗</span></a>
				</div>
			</div>
		</section>
		<section class="proof-row" aria-label="Project details">
			<div><span class="proof-value">42.8 KB</span><span class="proof-label">hello worker · gzip</span></div>
			<div><span class="proof-value">288 KB</span><span class="proof-label">REST example · gzip</span></div>
			<p>Measured from the committed examples. See the size pipeline and source in the repository.</p>
		</section>
		<section class="open-source-band">
			<div><span class="status-mark" aria-hidden="true">●</span><span class="mono-label">Built in the open</span></div>
			<p>No hosted vendor owns the project. Run it locally, inspect the tests, and deploy to your own Cloudflare account.</p>
			<a class="text-link" href="https://github.com/phongsathornpt/tiny-worker">Read the code <span aria-hidden="true">↗</span></a>
		</section>
	</main>
}

templ Docs() {
	@Layout("Documentation", DocsContent())
}

templ DocsContent() {
	<main class="page-shell docs-shell">
		<div class="page-meta"><span>Documentation</span><span>Framework guide</span></div>
		<section class="intro intro--compact">
			<h1>Documentation</h1>
			<p>Follow the framework from first install to a deployed Cloudflare Worker.</p>
		</section>
		<section class="index-section">
			<div class="section-label">Guide</div>
			<div class="index-body">
				<div class="index-list">
					<a href="/quickstart/"><span class="index-number">01</span><span><strong>Quickstart</strong><small>Install TinyGo, scaffold a project, and start Wrangler.</small></span><span class="index-arrow">↗</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker#quickstart"><span class="index-number">02</span><span><strong>Routing and middleware</strong><small>Route methods and paths through the request pipeline.</small></span><span class="index-arrow">↗</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker#rest-apis-rest-package"><span class="index-number">03</span><span><strong>Typed REST APIs</strong><small>Bind JSON, query values, and path parameters.</small></span><span class="index-arrow">↗</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker#build-flags--size-pipeline"><span class="index-number">04</span><span><strong>Build and deploy</strong><small>TinyGo, wasm-opt, Wrangler dev, and deploy.</small></span><span class="index-arrow">↗</span></a>
					<a href="https://github.com/phongsathornpt/tiny-worker#performance"><span class="index-number">05</span><span><strong>Performance</strong><small>Bundle sizes and request-path benchmarks.</small></span><span class="index-arrow">↗</span></a>
				</div>
			</div>
		</section>
	</main>
}

templ Quickstart() {
	@Layout("Quickstart", QuickstartContent())
}

templ QuickstartContent() {
	<main class="page-shell docs-shell">
		<div class="page-meta"><span>Quickstart</span><span>Local development</span></div>
		<section class="intro intro--compact">
			<h1>Run a worker locally.</h1>
			<p>Install Go and TinyGo, then use the tiny-worker CLI to create a REST-ready project.</p>
		</section>
		<section class="quick-steps">
			<div><span class="step-index">01</span><h2>Install the CLI</h2><pre><code>go install github.com/phongsathornpt/tiny-worker/cmd/tiny-worker@latest</code></pre></div>
			<div><span class="step-index">02</span><h2>Create a project</h2><pre><code>tiny-worker new my-api
cd my-api</code></pre></div>
			<div><span class="step-index">03</span><h2>Build and serve</h2><pre><code>tiny-worker dev</code></pre><p>Wrangler serves the compiled worker locally at <code>localhost:8787</code>.</p></div>
		</section>
		<p class="return-link"><a class="text-link" href="/docs/">Browse all documentation <span aria-hidden="true">→</span></a></p>
	</main>
}

templ Contributing() {
	@Layout("Contributing", ContributingContent())
}

templ ContributingContent() {
	<main class="page-shell docs-shell">
		<div class="page-meta"><span>Open source</span><span>Contributing</span></div>
		<section class="intro intro--compact">
			<h1>Help make the small path better.</h1>
			<p>tiny-worker is developed in public. Read the code, report a concrete problem, or propose a focused change.</p>
		</section>
		<section class="contribute-grid">
			<a href="https://github.com/phongsathornpt/tiny-worker/issues"><span class="step-index">01</span><h2>Open an issue</h2><p>Describe the behavior, include a small reproduction, and share the Go or TinyGo versions.</p></a>
			<a href="https://github.com/phongsathornpt/tiny-worker/tree/main/examples"><span class="step-index">02</span><h2>Try an example</h2><p>Build the hello and REST workers to see the supported request and deployment paths.</p></a>
			<a href="https://github.com/phongsathornpt/tiny-worker/blob/main/Makefile"><span class="step-index">03</span><h2>Send a patch</h2><p>Run the repository checks, then open a pull request with the change and its evidence.</p></a>
		</section>
	</main>
}

templ HelloExampleFragment() {
	<pre><code>go install github.com/phongsathornpt/tiny-worker/cmd/tiny-worker@latest
tiny-worker new myworker
cd myworker
tiny-worker dev</code></pre>
}

templ RESTExampleFragment() {
	<pre><code>rest.Get(r, "/api/v1/users", rest.HandlerNoInput(listUsers))
rest.Post(r, "/api/v1/users", rest.Handler(createUser))</code></pre>
}
