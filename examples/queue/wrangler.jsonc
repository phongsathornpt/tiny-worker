{
  "name": "tiny-worker-queue-example",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "consumers": [
    {
      "queue": "tiny-worker-example-orders",
      "max_batch_size": 10,
      "max_retries": 3,
      "dead_letter_queue": "tiny-worker-example-orders-dlq"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ORDERS", "queue": "tiny-worker-example-orders" }
    ]
  }
}
